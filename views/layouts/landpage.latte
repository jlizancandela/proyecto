<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Peluquería SR - Reserva online tu cita para corte de pelo, tinte, tratamientos capilares y más. Profesionales con experiencia a tu servicio."
    />
    <meta
      name="keywords"
      content="peluquería, corte de pelo, tinte, tratamientos capilares, reserva online, citas peluquería"
    />
    <link rel="canonical" href="https://app.jorgelizancandela.com" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://app.jorgelizancandela.com" />
    <meta property="og:title" content="Peluquería SR - Reserva tu Cita Online" />
    <meta
      property="og:description"
      content="Servicios profesionales de peluquería con sistema de reservas online. Corte, tinte y tratamientos capilares."
    />
    <meta property="og:image" content="https://app.jorgelizancandela.com/favicon.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://app.jorgelizancandela.com" />
    <meta property="twitter:title" content="Peluquería SR - Reserva tu Cita Online" />
    <meta
      property="twitter:description"
      content="Servicios profesionales de peluquería con sistema de reservas online."
    />
    <meta property="twitter:image" content="https://app.jorgelizancandela.com/favicon.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <title>Peluquería SR</title>
    {include 'landing-scripts.latte'} {block scripts} {/block}
  </head>

  <body>
    <credentials-card></credentials-card>
    <header>{include '../components/header.latte'}</header>
    <div class="container" style="max-width: 1400px">
      <main class="pt-4">{block content}{/block}</main>
    </div>
    {include '../components/footer.latte'}
  </body>
</html>
