<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{block title}Panel de Administración{/block} - Peluquería SR</title>
    {include 'panelScripts.latte'}
  </head>
  <body>
    {* Navbar móvil con botón hamburguesa *}
    <nav class="navbar navbar-light bg-white border-bottom d-md-none sticky-top">
      <div class="container-fluid">
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="offcanvas"
          data-bs-target="#sidebarOffcanvas"
          aria-controls="sidebarOffcanvas"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <a href="/" class="navbar-brand mb-0 h5 text-decoration-none">
          <i class="bi bi-scissors text-primary me-2"></i>
          SR-Peluquería
        </a>
        <div></div>
        {* Spacer para centrar el título *}
      </div>
    </nav>

    <div class="container-fluid">
      <div class="row">
        {include '../components/sidebar.latte', userName: $userName}
        <main class="col-md-9 col-lg-10 px-0 py-0">
          {include '../components/admin-breadcrumb.latte', currentUrl: $currentUrl}
          <div class="px-2 px-md-4 py-3 py-md-4">
            {include '../components/global-alerts.latte'}
            {block content}{/block}
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
