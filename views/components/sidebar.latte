{* Definición del menú para reutilizar *}
{define adminMenu}
<nav class="nav flex-column flex-grow-1 p-3">
  <a
    class="nav-link d-flex align-items-center gap-2 {if $currentUrl === '/admin'}text-dark bg-light{else}text-secondary{/if} rounded mb-1 py-2"
    href="/admin"
  >
    <i class="bi bi-grid-3x3-gap"></i>
    <span>Dashboard</span>
  </a>
  <a
    class="nav-link d-flex align-items-center gap-2 {if str_contains($currentUrl, '/admin/bookings')}text-dark bg-light{else}text-secondary{/if} rounded mb-1 py-2"
    href="/admin/bookings"
  >
    <i class="bi bi-calendar-check"></i>
    <span>Gestión de Citas</span>
  </a>
  <a
    class="nav-link d-flex align-items-center gap-2 {if str_contains($currentUrl, '/admin/users')}text-dark bg-light{else}text-secondary{/if} rounded mb-1 py-2"
    href="/admin/users"
  >
    <i class="bi bi-people"></i>
    <span>Gestión de Usuarios</span>
  </a>
  <a
    class="nav-link d-flex align-items-center gap-2 {if str_contains($currentUrl, '/admin/specialists')}text-dark bg-light{else}text-secondary{/if} rounded mb-1 py-2"
    href="/admin/specialists"
  >
    <i class="bi bi-person-badge"></i>
    <span>Gestión de Especialistas</span>
  </a>
  <a
    class="nav-link d-flex align-items-center gap-2 {if str_contains($currentUrl, '/admin/services')}text-dark bg-light{else}text-secondary{/if} rounded mb-1 py-2"
    href="/admin/services"
  >
    <i class="bi bi-scissors"></i>
    <span>Gestión de Servicios</span>
  </a>
</nav>
{/define}

{* Sidebar visible en desktop, offcanvas en móvil *}
<aside
  class="d-none d-md-flex col-md-3 col-lg-2 bg-white border-end min-vh-100 flex-column sticky-md-top overflow-auto"
>
  <div class="p-4 border-bottom">
    <div class="d-flex align-items-center">
      <a href="/" class="text-decoration-none d-flex align-items-center">
        <i class="bi bi-scissors text-primary fs-4 me-2"></i>
        <h5 class="mb-0 fw-bold">SR-Peluquería</h5>
      </a>
    </div>
  </div>

  {include adminMenu}

  <div class="p-3 border-top mt-auto dropup">
    <div
      class="d-flex align-items-center dropdown-toggle"
      data-bs-toggle="dropdown"
      aria-expanded="false"
      role="button"
    >
      <div class="me-3">
        <i class="bi bi-person-circle fs-2 text-secondary"></i>
      </div>
      <div class="flex-grow-1 min-w-0">
        <div class="fw-semibold small text-truncate">{$userName}</div>
        <div class="text-muted small">Administrador</div>
      </div>
    </div>
    <ul class="dropdown-menu shadow w-100 mb-2">
      <li>
        <a class="dropdown-item text-danger d-flex align-items-center gap-2" href="/logout">
          <i class="bi bi-box-arrow-right"></i>
          <span>Cerrar Sesión</span>
        </a>
      </li>
    </ul>
  </div>
</aside>

{* Offcanvas para móvil *}
<div
  class="offcanvas offcanvas-start d-md-none"
  tabindex="-1"
  id="sidebarOffcanvas"
  aria-labelledby="sidebarOffcanvasLabel"
>
  <div class="offcanvas-header border-bottom">
    <div class="d-flex align-items-center">
      <i class="bi bi-scissors text-primary fs-4 me-2"></i>
      <h5 class="mb-0 fw-bold" id="sidebarOffcanvasLabel">SR-Peluquería</h5>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>

  <div class="offcanvas-body d-flex flex-column">
    {include adminMenu}

    <div class="px-3 py-2">
      <a href="/" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2">
        <i class="bi bi-house"></i>
        <span>Volver a Inicio</span>
      </a>
    </div>

    <div class="border-top pt-3 mt-auto dropup">
      <div
        class="d-flex align-items-center dropdown-toggle"
        data-bs-toggle="dropdown"
        aria-expanded="false"
        role="button"
      >
        <div class="me-3">
          <i class="bi bi-person-circle fs-2 text-secondary"></i>
        </div>
        <div class="flex-grow-1 min-w-0">
          <div class="fw-semibold small text-truncate">{$userName}</div>
          <div class="text-muted small">Administrador</div>
        </div>
      </div>
      <ul class="dropdown-menu shadow w-100 mb-2">
        <li>
          <a class="dropdown-item text-danger d-flex align-items-center gap-2" href="/logout">
            <i class="bi bi-box-arrow-right"></i>
            <span>Cerrar Sesión</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</div>
