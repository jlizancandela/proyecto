{if $latestReserva}
{var $rawUrl = $latestReserva->especialista_foto_url ?? '/public/img/default-specialist.jpg'}
{var $fotoUrl = str_replace('?tr=w-300,h-300,q-80,f-auto', '', $rawUrl)}
<div
  class="card border-0 shadow rounded-4 overflow-hidden mb-4 position-relative"
  style="min-height: 200px; background-image: url('{$fotoUrl}'); background-size: cover; background-position: center 20%;"
>
  <!-- Overlay oscuro para legibilidad -->
  <div
    class="position-absolute top-0 start-0 w-100 h-100"
    style="background: linear-gradient(to right, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.6) 60%, rgba(0,0,0,0.3) 100%);"
  ></div>

  <div class="card-body p-4 position-relative d-flex flex-column h-100 justify-content-center">
    <!-- Encabezado: Badge -->
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span
        class="badge rounded-pill bg-white text-dark px-3 py-1 fw-bold border border-light"
        style="font-size: 0.7rem; letter-spacing: 0.5px"
      >
        PRÓXIMA VISITA
      </span>
    </div>

    <!-- Título -->
    <h3 class="card-title fw-bold text-white mb-1 h4">
      {$latestReserva->servicio_nombre}
    </h3>
    <p class="text-white-50 mb-3 small">
      con <span class="text-white fw-medium">{$latestReserva->especialista_nombre}</span>
    </p>

    <!-- Fecha y Hora -->
    <div class="d-flex align-items-center text-white mb-3">
      <div class="d-flex align-items-center me-3 bg-white bg-opacity-10 px-3 py-2 rounded-3 backdrop-blur-sm border border-white border-opacity-10">
        <i class="bi bi-calendar-event me-2 text-warning"></i>
        <span class="fw-medium">{$latestReserva->fecha_reserva|date:'d/m/Y'}</span>
      </div>
      <div class="d-flex align-items-center bg-white bg-opacity-10 px-3 py-2 rounded-3 backdrop-blur-sm border border-white border-opacity-10">
        <i class="bi bi-clock me-2 text-warning"></i>
        <span class="fw-medium">{$latestReserva->hora_inicio|date:'H:i'}</span>
      </div>
    </div>

    <!-- Botones de Acción -->
    <div class="mt-auto">
      <a
        href="/user/reservas/modify/{$latestReserva->id_reserva}"
        class="btn btn-light px-4 py-2 rounded-pill fw-bold btn-sm shadow-sm"
        style="font-size: 0.8rem"
      >
        <i class="bi bi-pencil-square me-1"></i> Reprogramar
      </a>
    </div>
  </div>
</div>
{/if}
