{if $latestReserva}
<div class="card border-0 shadow rounded-4 overflow-hidden mb-4 bg-white" style="min-height: 160px">
  <div class="row g-0 h-100">
    <!-- Columna de Imagen -->
    <div class="col-4 position-relative h-100">
      <img
        src="{$latestReserva->especialista_foto_url ?? '/public/img/default-specialist.jpg'}"
        class="img-fluid h-100 w-100 object-fit-cover"
        style="object-position: center 25%; position: absolute; top: 0; left: 0;"
        alt="{$latestReserva->especialista_nombre ?? 'Especialista'}"
      />
    </div>

    <!-- Columna de Contenido -->
    <div class="col-8">
      <div class="card-body p-3 d-flex flex-column h-100 justify-content-center">
        <!-- Encabezado: Badge y Check -->
        <div class="d-flex justify-content-between align-items-center mb-1">
          <span
            class="badge rounded-pill bg-danger-subtle text-danger px-2 py-1 fw-bold"
            style="font-size: 0.65rem; letter-spacing: 0.5px"
          >
            PRÓXIMA VISITA
          </span>
          <div
            class="rounded-circle bg-success-subtle d-flex align-items-center justify-content-center d-none d-sm-flex"
            style="width: 24px; height: 24px"
          >
            <i class="fas fa-check text-success" style="font-size: 0.7rem"></i>
          </div>
        </div>

        <!-- Título -->
        <h3 class="card-title fw-bold mb-1 text-dark h6 mb-0">
          {$latestReserva->servicio_nombre}
          <span class="fw-normal d-block small text-muted" style="font-size: 0.75rem">
            con {$latestReserva->especialista_nombre}
          </span>
        </h3>

        <!-- Fecha y Hora -->
        <div class="d-flex align-items-center text-muted mb-2 small" style="font-size: 0.75rem">
          <i class="bi bi-calendar-event me-2 text-danger"></i>
          {$latestReserva->fecha_reserva|date:'d/m/Y'}, {$latestReserva->hora_inicio|date:'H:i'}
        </div>

        <!-- Botones de Acción -->
        <div class="mt-auto">
          <a
            href="/user/reservas/modify/{$latestReserva->id_reserva}"
            class="btn btn-primary px-3 py-1 rounded-3 fw-medium btn-sm"
            style="font-size: 0.75rem"
          >
            Reprogramar
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
{/if}
