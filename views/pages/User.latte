{layout '../layouts/user-panel-layout.latte'} {block title}Panel de Usuario{/block} {block head}{/block} {block content}
<div class="container-fluid p-0">
  <div class="row mb-4">
    <div class="col-12">
      <h1 class="h2 mb-2 text-dark fw-bold">
        Hola, {$userName}
        <span class="wave-emoji">👋</span>
      </h1>
      <p class="text-muted">Bienvenido de nuevo a tu panel de control.</p>
    </div>
  </div>

  {* Next Appointment Card *} {if isset($latestReserva) && $latestReserva}
  <div class="row mb-4">
    <div class="col-12">
      {include '../components/booking-last-card.latte', latestReserva: $latestReserva}
    </div>
  </div>
  {/if} {* If no upcoming appointment, show general info *} {if !isset($latestReserva) ||
  !$latestReserva}
  <div class="alert alert-light border shadow-sm rounded-4 p-4 mb-4">
    <div class="d-flex align-items-center">
      <div class="rounded-circle bg-primary-subtle p-3 me-3 text-primary">
        <i class="fas fa-calendar-plus fa-2x"></i>
      </div>
      <div>
        <h4 class="alert-heading fw-bold mb-1">¡Agenda tu próxima visita!</h4>
        <p class="mb-0 text-muted">
          Aún no tienes citas próximas. Explora nuestros servicios y reserva hoy mismo.
        </p>
      </div>
      <a href="/user/reservas/nueva" class="btn btn-primary ms-auto px-4 rounded-pill">
        Nueva Reserva
      </a>
    </div>
  </div>
  {/if} {* Quick Actions Section *}
  <h4 class="h5 fw-bold text-dark mb-3">Accesos Rápidos</h4>
  {include '../components/user-quick-actions.latte'} {* Offers Section (Static for now) *}
  <h4 class="h5 fw-bold text-dark mb-3">Ofertas para ti</h4>
  {include '../components/user-offers.latte'}
</div>

<style>
  .wave-emoji {
    display: inline-block;
    animation: wave 2.5s infinite;
  }
  @keyframes wave {
    0% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
    60% { transform: rotate(0deg); }
    100% { transform: rotate(0deg); }
  }
</style>
{/block}
